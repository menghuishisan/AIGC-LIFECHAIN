# ============================================================
# AIGC-LifeChain 后端环境变量配置
#
# 使用方式：复制本文件为 .env 并填写真实值
#   cp .env.example .env
#
# .env 文件绝对不可提交到版本库（已在 .gitignore 中排除）
# 所有变量名与 application.yml 中的 ${} 占位符一一对应
# ============================================================

# ======================== 数据库 ========================
# MySQL 主机地址（对应 spring.datasource url 中的 host，默认 localhost）
DB_HOST=localhost
# MySQL 端口（对应 spring.datasource url 中的 port）
# 如果使用 infra/docker-compose.yml 启动的 MySQL 容器，填 3307
# 如果使用本地安装的 MySQL，填 3306
DB_PORT=3307
# 数据库名（对应 spring.datasource url 中的 database）
DB_NAME=lifechain
# 数据库用户名（对应 spring.datasource.username）
DB_USER=root
# MySQL 连接密码（对应 spring.datasource.password，必填）
DB_PASSWORD=123456

# ======================== Redis ========================
# Redis 主机地址（对应 spring.data.redis.host，默认 localhost）
REDIS_HOST=localhost
# Redis 端口（对应 spring.data.redis.port）
# 如果使用 infra/docker-compose.yml 启动的 Redis 容器，填 6380
# 如果使用本地安装的 Redis，填 6379
REDIS_PORT=6380

# ======================== MinIO 对象存储 ========================
# MinIO API 地址（对应 minio.endpoint）
# 如果使用 infra/docker-compose.yml 启动的 MinIO 容器，填 http://localhost:9020
# 如果使用本地安装的 MinIO，填 http://localhost:9000
MINIO_ENDPOINT=http://localhost:9020
# MinIO 访问密钥（对应 minio.accessKey，必填）
MINIO_ACCESS_KEY=minioadmin
# MinIO 密钥（对应 minio.secretKey，必填，至少 8 字符）
MINIO_SECRET_KEY=minioadmin
# MinIO 桶名称（对应 minio.bucketName，默认 lifechain）
MINIO_BUCKET=lifechain
# MinIO 公开桶名称（封面/缩略图，public-read 策略）
MINIO_PUBLIC_BUCKET=lifechain-public

# ======================== JWT 认证 ========================
# JWT 签名密钥（对应 lifechain.jwt.secret，必填）
# 生成方式: openssl rand -base64 64
JWT_SECRET=

# ======================== 微信支付（可选） ========================
# 不接入微信支付可全部留空
# 微信支付应用 AppId（对应 lifechain.pay.wechat.appId）
WECHAT_APP_ID=
# 微信商户号（对应 lifechain.pay.wechat.mchId）
WECHAT_MCH_ID=
# 微信支付 API v3 密钥，用于回调解密（对应 lifechain.pay.wechat.apiV3Key）
WECHAT_API_V3_KEY=
# 微信商户 API 证书序列号（对应 lifechain.pay.wechat.serialNumber）
WECHAT_SERIAL_NUMBER=
# 微信商户 API 私钥文件路径（对应 lifechain.pay.wechat.privateKeyPath）
WECHAT_PRIVATE_KEY_PATH=
# 微信支付平台证书文件路径（对应 lifechain.pay.wechat.certificatePath）
WECHAT_CERTIFICATE_PATH=
# 微信支付异步回调地址，需公网可访问（对应 lifechain.pay.wechat.notifyUrl）
WECHAT_NOTIFY_URL=http://localhost:8080/api/payments/wechat/callback
# 微信退款异步回调地址（对应 lifechain.pay.wechat.refundNotifyUrl）
WECHAT_REFUND_NOTIFY_URL=http://localhost:8080/api/payments/wechat/callback

# ======================== 支付宝（可选） ========================
# 不接入支付宝可全部留空
# 支付宝应用 AppId（对应 lifechain.pay.alipay.appId）
ALIPAY_APP_ID=
# 商户私钥，用于生成签名（对应 lifechain.pay.alipay.privateKey）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥，用于验签（对应 lifechain.pay.alipay.alipayPublicKey）
ALIPAY_PUBLIC_KEY=
# 支付宝支付异步回调地址（对应 lifechain.pay.alipay.notifyUrl）
ALIPAY_NOTIFY_URL=http://localhost:8080/api/payments/alipay/callback
# 支付宝退款异步回调地址（对应 lifechain.pay.alipay.refundNotifyUrl）
ALIPAY_REFUND_NOTIFY_URL=http://localhost:8080/api/payments/alipay/callback
# 支付宝网关地址（对应 lifechain.pay.alipay.serverUrl）
# 沙箱: https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 正式: https://openapi.alipay.com/gateway.do
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ======================== 短信 ========================
# 开发模式：验证码输出到日志而非真实发送（对应 lifechain.sms.dev-mode）
# 生产环境必须设为 false
SMS_DEV_MODE=true

# ======================== Hyperledger Fabric ========================
# Fabric 网络连接配置文件路径（对应 app.fabric.networkConfigPath）
# 开发环境使用相对路径即可，生产环境填绝对路径
FABRIC_NETWORK_CONFIG=./runtime-config/fabric/org1/connection-org1.json
# 通道名称（对应 app.fabric.channelName）
FABRIC_CHANNEL=lifechainchannel
# 调用链码的用户 ID（对应 app.fabric.userId）
FABRIC_USER=admin
# 组织 MSP ID（对应 app.fabric.mspId）
FABRIC_MSP=Org1MSP
# Admin 用户 X509 证书 PEM 文件路径（对应 app.fabric.certPath）
FABRIC_CERT_PATH=./runtime-config/fabric/org1/admin-cert.pem
# Admin 用户私钥 PEM 文件路径（对应 app.fabric.keyPath）
FABRIC_KEY_PATH=./runtime-config/fabric/org1/admin-key.pem
# Peer 节点地址（对应 app.fabric.peerEndpoint）
FABRIC_PEER=localhost:7051
# TLS CA 证书路径（对应 app.fabric.tlsCertPath，开发环境 TLS 关闭留空）
FABRIC_TLS_CERT=
# TLS 主机名覆盖（对应 app.fabric.overrideAuth，开发测试用）
FABRIC_OVERRIDE_AUTH=peer0.org1.lifechain.com

# ======================== 雪花 ID ========================
# 工作节点 ID，多实例部署时每个实例不同（对应 app.snowflake.workerId）
SNOWFLAKE_WORKER_ID=1
# 数据中心 ID（对应 app.snowflake.datacenterId）
SNOWFLAKE_DATACENTER_ID=1

# ======================== 应用配置 ========================
# Swagger/OpenAPI 文档开关（对应 springdoc.api-docs.enabled / swagger-ui.enabled）
# 开发环境 true，生产环境 false
SWAGGER_ENABLED=true
# 是否信任反向代理转发头（对应 app.security.trust-forward-headers）
# 仅在 Nginx 等可信代理后开启
TRUST_FORWARD_HEADERS=false
# CORS 允许的前端来源（对应 app.cors.allowed-origins）
# 多个来源逗号分隔，开发环境填前端 dev server 地址
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ======================== 日志 ========================
# 日志输出根目录（对应 logging.file.path，必填）
# 开发环境填 ./logs，相对启动脚本 cwd（即 backend/）
# 生产环境建议改为绝对路径，如 /var/log/lifechain
LOG_PATH=./logs

# ======================== 可观测性 ========================
# 分布式追踪开关（对应 management.tracing.enabled，必填）
# 关闭后不再向 OTLP 端点导出 span，但 micrometer 仍会生成 traceId 用于日志关联
OBSERVABILITY_TRACING_ENABLED=true
# 追踪采样率（对应 management.tracing.sampling.probability，必填）
# 开发 1.0 全采样，生产建议 0.1
OBSERVABILITY_TRACING_SAMPLING=1.0
# OTLP 接收端地址（对应 management.otlp.tracing.endpoint，必填）
# 指向 OTel Collector 的 HTTP/protobuf 端口（infra/docker-compose.yml 中映射为 4320），
# 由 Collector 在容器网络内用 gRPC 转发到 Jaeger，App 端只需 HTTP/protobuf
OBSERVABILITY_OTLP_ENDPOINT=http://localhost:4320/v1/traces
# 部署环境标签（对应 management.opentelemetry.resource-attributes.deployment.environment，必填）
# 用于在 Jaeger / Prometheus 中区分 dev / staging / prod
OBSERVABILITY_DEPLOY_ENV=dev

# fabric-sdk-java 在内部构造 AutoConfiguredOpenTelemetrySdk，默认注册 OTLP gRPC exporter (4317)，
# 与 Spring Boot OtlpAutoConfiguration 自建的 HTTP exporter 重复，会每分钟刷一次 export 失败告警。
# 这三个变量是 OTel autoconfigure 规范定义的标准开关，告诉那一份 SDK 不要装配任何默认 exporter。
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
