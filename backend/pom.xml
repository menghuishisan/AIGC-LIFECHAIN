<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lifechain</groupId>
    <artifactId>lifechain-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>AIGC-LifeChain Backend</name>
    <description>AIGC内容可信管理平台后端</description>

    <modules>
        <module>lifechain-common</module>
        <module>lifechain-infra</module>
        <module>lifechain-chain</module>
        <module>lifechain-auth</module>
        <module>lifechain-work</module>
        <module>lifechain-trade</module>
        <module>lifechain-settlement</module>
        <module>lifechain-regulator</module>
        <module>lifechain-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <lombok.version>1.18.32</lombok.version>
        <jjwt.version>0.12.5</jjwt.version>
        <minio.version>8.5.9</minio.version>
        <milvus-sdk.version>2.4.1</milvus-sdk.version>
        <!-- 新版 Hyperledger Fabric Gateway SDK（基于 gRPC 直连 peer，无 fabric-sdk-java/log4j2/老 protobuf 历史包袱） -->
        <fabric-gateway.version>1.7.1</fabric-gateway.version>
        <grpc-netty.version>1.65.1</grpc-netty.version>
        <!--
            覆盖 Spring Boot BOM（3.2.5）默认的 protobuf-java=3.24.0：
            fabric-gateway:1.7.1 的 vendored protos gencode 由 protobuf-compiler 4.28.2 生成，
            运行时校验 RuntimeVersion，要求 protobuf-java runtime ≥ 4.28.2，否则抛
            ProtobufRuntimeVersionException。
        -->
        <protobuf-java.version>4.28.2</protobuf-java.version>
        <wechatpay.version>0.2.14</wechatpay.version>
        <alipay-sdk.version>4.39.79.ALL</alipay-sdk.version>
        <hutool.version>5.8.27</hutool.version>
        <redisson.version>3.27.2</redisson.version>
        <springdoc.version>2.5.0</springdoc.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <openpdf.version>2.0.2</openpdf.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 显式覆盖 Spring Boot BOM 的 protobuf-java，使其生效（BOM 直接写死版本号，property 不会被替换） -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf-java.version}</version>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.lifechain</groupId>
                <artifactId>lifechain-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifechain</groupId>
                <artifactId>lifechain-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifechain</groupId>
                <artifactId>lifechain-chain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifechain</groupId>
                <artifactId>lifechain-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifechain</groupId>
                <artifactId>lifechain-work</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifechain</groupId>
                <artifactId>lifechain-trade</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifechain</groupId>
                <artifactId>lifechain-settlement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lifechain</groupId>
                <artifactId>lifechain-regulator</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- MinIO -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- Hyperledger Fabric Gateway（新版 1.x，基于 gRPC 直连 peer） -->
            <dependency>
                <groupId>org.hyperledger.fabric</groupId>
                <artifactId>fabric-gateway</artifactId>
                <version>${fabric-gateway.version}</version>
            </dependency>
            <!-- gRPC 通道实现（fabric-gateway 仅依赖 grpc-api，运行期需要 netty 实现） -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-netty-shaded</artifactId>
                <version>${grpc-netty.version}</version>
            </dependency>

            <!-- 微信支付 -->
            <dependency>
                <groupId>com.github.wechatpay-apiv3</groupId>
                <artifactId>wechatpay-java</artifactId>
                <version>${wechatpay.version}</version>
            </dependency>

            <!-- 支付宝 -->
            <dependency>
                <groupId>com.alipay.sdk</groupId>
                <artifactId>alipay-sdk-java</artifactId>
                <version>${alipay-sdk.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.bouncycastle</groupId>
                        <artifactId>bcprov-jdk15on</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>


            <!-- Redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- OpenPDF -->
            <dependency>
                <groupId>com.github.librepdf</groupId>
                <artifactId>openpdf</artifactId>
                <version>${openpdf.version}</version>
            </dependency>

            <!-- Milvus -->
            <dependency>
                <groupId>io.milvus</groupId>
                <artifactId>milvus-sdk-java</artifactId>
                <version>${milvus-sdk.version}</version>
                <exclusions>
                    <!--
                        milvus-sdk-java:2.4.x 出于历史原因把整套 hadoop-client 拖进来（仅为了 hadoop-common
                        的 Configuration 类），同时还自带 log4j2 + slf4j-reload4j 两个 SLF4J provider，
                        与 Spring Boot 默认的 Logback 强冲突，启动时会触发 SLF4J 多 provider 选择和
                        Reload4j 在 ConcurrentHashMap 上的 "Recursive update" 异常。
                        生产做法：在父 pom 集中剔除这些传递依赖，确保整个项目只保留 Logback 一个日志后端，
                        同时去掉 hadoop-client 拖来的 60+ MB 老依赖（protobuf-2.5/netty-3/jersey-1.x 等），
                        减少 jar 体积与 CVE 暴露面。
                    -->
                    <exclusion>
                        <groupId>org.apache.hadoop</groupId>
                        <artifactId>hadoop-client</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.apache.logging.log4j</groupId>
                        <artifactId>log4j-slf4j-impl</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.apache.logging.log4j</groupId>
                        <artifactId>log4j-core</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.apache.logging.log4j</groupId>
                        <artifactId>log4j-1.2-api</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.slf4j</groupId>
                        <artifactId>slf4j-reload4j</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.slf4j</groupId>
                        <artifactId>slf4j-log4j12</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>log4j</groupId>
                        <artifactId>log4j</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>ch.qos.reload4j</groupId>
                        <artifactId>reload4j</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                maven-enforcer-plugin: 在编译期硬性约束依赖卫生
                - bannedDependencies：禁止任何模块再次引入 Logback 之外的 SLF4J provider 或老 log4j 实现，
                  防止未来升级 milvus / 引入新 SDK 时又把 Reload4j / log4j2 / log4j-1.x 拖回来。
                - dependencyConvergence：禁止同一 artifact 出现多个版本（避免运行期类加载顺序决定行为）。
                - requireMavenVersion / requireJavaVersion：固定构建环境最低要求。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-dependency-hygiene</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- 多 SLF4J provider 会导致启动期 ConcurrentHashMap 递归更新异常 -->
                                        <exclude>org.slf4j:slf4j-reload4j</exclude>
                                        <exclude>org.slf4j:slf4j-log4j12</exclude>
                                        <exclude>org.slf4j:slf4j-simple</exclude>
                                        <exclude>org.slf4j:slf4j-jdk14</exclude>
                                        <!-- log4j2 作为 SLF4J 后端会与 Logback 双绑定 -->
                                        <exclude>org.apache.logging.log4j:log4j-slf4j-impl</exclude>
                                        <exclude>org.apache.logging.log4j:log4j-slf4j2-impl</exclude>
                                        <!-- 老 log4j 1.x 与其重打包（CVE 面积大且无人维护） -->
                                        <exclude>log4j:log4j</exclude>
                                        <exclude>ch.qos.reload4j:reload4j</exclude>
                                        <!-- 整套 hadoop 客户端不是 milvus 真正需要的，避免误引回来 -->
                                        <exclude>org.apache.hadoop:hadoop-client</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
