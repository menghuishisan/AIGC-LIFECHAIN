{
  "name": "lifechain-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check src *.ts *.js *.json",
    "format": "prettier --write src *.ts *.js *.json"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.8",
    "pinia": "^2.1.7",
    "vue": "^3.5.45",
    "vue-router": "^4.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi",
      "@parcel/watcher"
    ],
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch": "^11.0.1",
      "eslint>minimatch": "^11.0.1",
      "@eslint/config-array>minimatch": "^11.0.1",
      "sass>immutable": "^5.1.9"
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "typescript": "^5.4.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.4.5",
    "vue-tsc": "^3.3.14"
  }
}
