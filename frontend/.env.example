# ============================================================
# AIGC-LifeChain 前端环境变量配置
#
# Vite 只会暴露 VITE_ 前缀的变量到客户端代码
# 开发环境读取 .env.development，生产构建读取 .env.production
# ============================================================

# 后端 API 请求前缀（对应 axios baseURL，开发环境由 vite proxy 转发到后端）
VITE_API_BASE_URL=/api

# 公开接口前缀（无需登录即可访问的接口，如验证页面）
VITE_PUBLIC_API_BASE_URL=/public
